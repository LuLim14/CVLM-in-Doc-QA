# ЕДИНЫЙ укороченный протокол для ВСЕХ веток абляции (DocInsights-2026 run).
# Правило: этот файл source-ится каждым sbatch; ветки различаются ТОЛЬКО
# переменными VIT_INIT / FREEZE_VIT / NO_VIT (и SFT_TRUNCATE_CR у SFT).
# Менять протокол = менять здесь, один раз, для всех веток сразу.

# --- модели (зафиксировано: ViT-Base, как в тексте ВКР) ---
export MODEL_NAME=HuggingFaceTB/SmolLM2-1.7B-Instruct
export TEXT_ENCODER_NAME=answerdotai/ModernBERT-base
export VISION_ENCODER_NAME=google/vit-base-patch16-224

# --- укороченный куррикулум (границы в optimizer-шагах; последний = навсегда) ---
# Полный протокол ВКР: 1:6000,2:12000,4:18000,8:24000,16:0 (~24k+ шагов).
# Укороченный: те же 5 стадий, сжатые в ~4 раза. После смоук-замера сек/шаг
# при необходимости скорректировать ЗДЕСЬ (одинаково для всех веток).
export CR_SCHEDULE="1:1500,2:3000,4:4500,8:6000,16:0"
export EVAL_CR_SCHEDULE="${CR_SCHEDULE}"
export EPOCHS=3                # верхняя граница; реальный стоп — конец эпох
export BATCH_SIZE=64           # при OOM: 32 + GRAD_ACCUM=2 (менять для ВСЕХ веток)
export GRAD_ACCUM=1
export LR=1e-4
export ENABLE_WARMUP=1
export WARMUP_STEPS=100
export DISABLE_LR_SCHEDULE=1
export GRADIENT_CHECKPOINTING=1
export UNFREEZE_ENCODER_TOP_K=22
export NUM_POOL_LATENTS=4
export MAX_PROMPT_LEN=512
export MAX_ANSWER_LEN=1024
export MAX_VISION_LEN=1024
# ЯВНО фиксируем фильтр источника (НЕ 0!): при 0 он равен cr*max_vision_len и
# сравнение между cr/ветками шло бы на разных подмножествах данных.
export MAX_SOURCE_LEN=1024
export COMPRESSION_RATE=1
export SAVE_INTERVAL_STEPS=1000  # + принудительные сейвы на границах стадий;
                                 # нужен для resume в 24h-окне cpu-e-quick

# --- eval ---
export EVAL_SPLIT=test
# Полный test PwC ~18k сэмплов; генеративные метрики на всех чекпоинтах не
# успеют. Единый капчёный сабсет для всех веток; финальные чекпоинты можно
# перегнать с EVAL_MAX_SAMPLES=0 после дедлайна.
export EVAL_MAX_SAMPLES=2000
export EVAL_BATCH_SIZE=8
export EVAL_MODES="cvlm baseline_llm baseline_llm_full"
export EVAL_COMPUTE_GEN=1
export EVAL_ALL_CHECKPOINTS=1

# --- пути на cHARISMa ---
export CVLM_ROOT=/home/aburlova/cvlm            # рабочая копия репозитория
export RUNS_ROOT=/home/aburlova/cvlm/runs
export HF_HOME=/home/aburlova/hf_cache
export HF_HUB_CACHE=/home/aburlova/hf_cache/hub
export HUGGINGFACE_HUB_CACHE=/home/aburlova/hf_cache/hub

# --- offline-режим компьют-нод ---
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_HUB_DISABLE_TELEMETRY=1
export TRACKIO_DISABLE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONNOUSERSITE=1
export NPROC=1                 # DDP не использовать: find_unused_parameters=False
                               # упадёт на неиспользуемых ViT.embeddings/pooler
export SEED=42
